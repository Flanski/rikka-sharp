+        ) {
+            item {
+                Text(
+                    "在这里配置远程主机与凭据，AI 即可通过 SSH 执行命令、上传下载文件。" +
+                        "凭据（密码/私钥）由系统 Keystore 加密后保存在本机，且与主机一一绑定。",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+
+            if (hosts.isEmpty()) {
