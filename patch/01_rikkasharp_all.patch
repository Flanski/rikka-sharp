-def fix_index(idx: int, mod: int = 12) -> int:
-    """修正索引到 [0, mod) 范围内 — 等价 iztro fixIndex"""
-    if idx < 0:
-        return fix_index(idx + mod, mod)
-    if idx > mod - 1:
-        return fix_index(idx - mod, mod)
-    return idx
