# Keep source locations so obfuscated release stack traces can be retraced.
-keepattributes SourceFile,LineNumberTable

# Ktor references JVM-only management APIs from its debug detector.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# Jackson references these JVM-only java.beans annotations.
-dontwarn java.beans.ConstructorProperties
-dontwarn java.beans.Transient

# re2j has optional references that are unavailable on Android.
-dontwarn com.google.re2j.**

# Jackson TypeReference reads its anonymous subclass's generic superclass at runtime.
-keepattributes Signature,InnerClasses,EnclosingMethod
-keep,allowobfuscation class * extends com.fasterxml.jackson.core.type.TypeReference

# JLaTeXMath loads these optional alphabet registrations by their binary names.
-keep,allowoptimization class org.scilab.forge.jlatexmath.cyrillic.CyrillicRegistration {
    public <init>();
}
-keep,allowoptimization class org.scilab.forge.jlatexmath.greek.GreekRegistration {
    public <init>();
}

# Chaquopy bridge — 所有方法通过Python反射调用，R8不能删
-keep class me.rerere.rikkahub.data.ai.python.PythonBridge { *; }
-keep class me.rerere.rikkahub.data.ai.python.JsBridge { *; }

# ── JSch（SSH 客户端）─────────────────────────────────────────────
# JSch 把**所有算法实现类的名字放在配置字符串里**（例如
#   config.put("random",                "com.jcraft.jsch.jce.Random")
#   config.put("ssh-ed25519",           "com.jcraft.jsch.bc.SignatureEd25519")
#   config.put("kex",                   "com.jcraft.jsch.DHG14")  ...）
# 再按运行时条件（JavaVersion、可用性）动态加载。R8 做静态引用分析时
# **看不到这些字符串与类之间的关联**，会把它们整体裁掉，运行期就报
#   ClassNotFoundException: com.jcraft.jsch.jce.Random      （random / 各种算法）
#   JavaCipher … invalid privatekey                          （bc 实现缺失）
# JSch.class 里共有 69 个这样的类名（jce 34 个、bc 9 个、jbcrypt 1 个、顶层 DH 24 个）。
# 逐个列举容易漏，且 JSch 以后新增算法也会漏 —— 直接整体 keep。
-keep class com.jcraft.jsch.** { *; }
#
# 但「整体 keep」会把 JSch 里**依赖可选库**的类一并保留，R8 随后会去解析它们
# 引用的类型并因缺失而报错（:app:minifyReleaseWithR8 FAILED）。这些功能在
# Android 上都不会被触发，故用 -dontwarn 抑制（R8 亦会在 missing_rules.txt 中建议同样规则）：
#   com.jcraft.jsch.PageantConnector     -> com.sun.jna.*                （Windows Pageant）
#   com.jcraft.jsch.Log4j2Logger         -> org.apache.logging.log4j.*   （log4j2 日志）
#   com.jcraft.jsch.jgss.GSSContextKrb5  -> org.ietf.jgss.*              （Kerberos）
#   com.jcraft.jsch.JUnixSocketFactory   -> org.newsclub.net.unix.*      （junixsocket）
-dontwarn com.sun.jna.**
-dontwarn org.apache.logging.log4j.**
-dontwarn org.ietf.jgss.**
-dontwarn org.newsclub.net.unix.**

# ── sherpa-onnx（本地 TTS）────────────────────────────────────────
# **必须整体 keep，且不能混淆字段名。**
#
# native 侧（JNI）是按**字段名**读取 Kotlin 配置对象的，例如：
#     jfieldID fid = GetFieldID(cls, "ruleFsts", "Ljava/lang/String;");
#     GetObjectField(obj, fid);
# 一旦 R8 把字段名混淆（实测被改成 a / b / c），GetFieldID 返回 NULL，
# native 侧随即解引用空指针 → SIGSEGV → **进程直接消失**：
#   · 没有 Java 异常（不是 Exception/Error）
#   · 因此 CrashHandler 的 uncaught 处理器与崩溃页都不会触发
#   · TtsController 里对 synthesize/play 的 try-catch 也捕获不到
# 用户看到的就是「播放语音时闪退」。
#
# 排查代价说明：这个 bug 无法用 C API 复现 —— C 版本用结构体传参、
# 不做任何字段名查找，所以底层怎么测都是好的；而 JNI 版本才会中招。
-keep class com.k2fsa.sherpa.onnx.** { *; }

# ── JGit（编程开发工具里的真 git）────────────────────────────────────
# **必须整体 keep。** 原因与 JSch 同类：JGit 通过 ServiceLoader / 反射按「名字」
# 加载实现类，静态分析看不到这些引用，R8 会把它们裁掉或改名，运行期才炸。
#   · org.eclipse.jgit.transport.Transport  —— 各协议实现（git/ssh/file/http）
#   · org.eclipse.jgit.transport.Protocol
#   · org.eclipse.jgit.transport.SshSessionFactory
#   · org.eclipse.jgit.hooks.*（pre-commit 等）
#   · org.eclipse.jgit.lib.GpgSigner
-keep class org.eclipse.jgit.** { *; }

# JGit 的可选依赖：这些模块我们**没有**引入，但 JGit 代码里引用了它们的类型。
# 不 dontwarn 的话 R8 在整体 keep 后会因「解析不到的引用」直接失败。
-dontwarn org.slf4j.**
-dontwarn javax.servlet.**
-dontwarn org.eclipse.jgit.lfs.**
-dontwarn org.eclipse.jgit.gpg.bc.**
-dontwarn org.eclipse.jgit.ssh.apache.**
-dontwarn org.eclipse.jgit.ssh.jsch.**
-dontwarn org.eclipse.jgit.http.server.**
-dontwarn com.jcraft.jsch.**
-dontwarn org.apache.sshd.**
-dontwarn org.bouncycastle.**
-dontwarn com.googlecode.javaewah.**
-dontwarn org.apache.http.**
-dontwarn org.ietf.jgss.**

# ── usb-serial-for-android（串口工具）────────────────────────────────
# 库内部通过 UsbSerialProber 的驱动表按设备 VID/PID 匹配驱动实现类。
# 这些类是代码里直接引用的（不是字符串反射），理论上 R8 能保住；
# 但为稳妥仍整体 keep —— 串口驱动的失败只在运行期暴露，代价高，不值得冒险。
-keep class com.hoho.android.usbserial.** { *; }
-dontwarn com.hoho.android.usbserial.**

# JGit 引用了 Android 上**不存在**的 Java SE 类，R8 会报 "Missing class" 而失败。
# 这些只在特定功能路径用到（JMX 监控 MBean、GC 的进程锁），Android 上不会执行到，
# 因此 dontwarn 即可 —— 不需要、也无法提供这些类。
#   实测缺失清单：java.lang.ProcessHandle（Java 9+ API，Android 无）
#                + javax.management.*（整个 JMX 包，共 10 个类）
-dontwarn java.lang.ProcessHandle
-dontwarn javax.management.**
-dontwarn java.lang.management.**

# BouncyCastle 内部大量使用反射/可选 API，放宽警告
-dontwarn org.bouncycastle.**
-dontwarn javax.naming.**

# 本地 Compose 自定义组件依赖
-keep class androidx.compose.animation.** { *; }
-keep class androidx.compose.runtime.** { *; }

# ── WorkManager ──────────────────────────────────────────────────────────────
# WorkManager **通过类名反射**实例化 Worker（读它自己数据库里记录的类名），
# R8 静态分析看不到这条引用 → 会把 Worker 类删除或改名 →
# 运行期抛 ClassNotFoundException（而且是在后台、没有界面的时候发生，很难定位）。
#
# 这与本项目此前踩过的两次是同一类问题：
#   · JSch 把算法类名放在配置字符串里 → R8 裁剪 → ClassNotFoundException；
#   · sherpa-onnx 的 JNI 按**字段名**读 Kotlin 配置 → R8 改字段名 → SIGSEGV。
# 凡是「按名字查找」的机制，都要显式 keep。
#
# 保留构造函数签名是因为 WorkManager 用 `(Context, WorkerParameters)` 反射构造，
# 只保留类名而构造签名被改，同样会失败。
-keep class * extends androidx.work.ListenableWorker {
    <init>(android.content.Context, androidx.work.WorkerParameters);
}

# ── Configuration.Provider（★实测会被 R8 删掉，必须显式保留）──────────────────
# WorkManager 在「按需初始化」时用的是**运行期 instanceof 检查**（库内部行为）：
#     if (appContext instanceof Configuration.Provider) { 用它的配置初始化 }
#     else { throw IllegalStateException("... does not implement Configuration.Provider") }
# 这个 instanceof 不在我们代码的静态调用图里，R8 看不到，
# 于是认为 Configuration.Provider **无人使用** → 把 RikkaHubApp 的接口实现删掉。
#
# 后果非常隐蔽：**编译期毫无提示**，构建也能成功；
# 但运行期 appContext 不再被识别为 Provider → 每次 WorkManager.getInstance() 都抛异常。
#
# 实测证据（在未加这条 keep 的构建产物里逐项确认）：
#   · `Landroidx/work/Configuration;`            → 存在（WorkManager 本身在包里）
#   · `Landroidx/work/Configuration$Provider;`   → **0 个**（接口引用被移除）
#   · `workManagerConfiguration` / `getWorkManagerConfiguration` → **0 个**（方法被移除）
#
# 注意这里用「所有实现者」而不是只写 RikkaHubApp：
#  · R8 只保留**接口实现这一事实**和构造/该方法，不会因此保留整个类的所有成员；
#  · 将来若有别的类实现该接口，也不会再踩同一个坑。
# 方法签名必须写全 —— 只保留类名而方法被改名/删除，运行期同样失败。
-keep class * implements androidx.work.Configuration$Provider {
    <init>();
}
-keepclassmembers class * implements androidx.work.Configuration$Provider {
    public androidx.work.Configuration getWorkManagerConfiguration();
}
